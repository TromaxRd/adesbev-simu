<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" xml:lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Dashboard AndesBev · {{ meta.run_id }}</title>
<style>
/*<![CDATA[*/
:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11,11,11,0.10);
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a;
  --good: #0ca30c; --warning: #fab219; --critical: #d03b3b; --band: rgba(235,104,52,0.10);
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,0.10);
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --band: rgba(217,89,38,0.16);
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
header { padding: 28px 24px 8px; max-width: 1180px; margin: 0 auto; }
header h1 { font-size: 24px; margin: 0 0 4px; font-weight: 650; letter-spacing: -0.01em; }
header p { margin: 0; color: var(--ink-2); }
nav { max-width: 1180px; margin: 12px auto 0; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 6px; }
nav a { font-size: 13px; color: var(--ink-2); text-decoration: none; padding: 4px 10px;
  border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
nav a:hover { color: var(--ink); border-color: var(--axis); }
main { max-width: 1180px; margin: 0 auto; padding: 8px 24px 48px; }
section { margin-top: 28px; }
section > h2 { font-size: 18px; margin: 0 0 4px; font-weight: 650; }
section > p.lead { margin: 0 0 14px; color: var(--ink-2); max-width: 820px; }
.grid { display: grid; gap: 14px; }
.g-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.g-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; min-width: 0; }
.card h3 { font-size: 14px; margin: 0 0 10px; font-weight: 600; }
.tile .k { font-size: 13px; color: var(--ink-2); }
.tile .v { font-size: 30px; font-weight: 650; letter-spacing: -0.02em; margin: 2px 0; }
.tile .n { font-size: 12.5px; color: var(--muted); }
.chart { position: relative; height: 280px; }
.chart.tall { height: 360px; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--ink-2); font-weight: 600; font-size: 12.5px; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.scroll { overflow-x: auto; }
.badge { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 1px 7px; border-radius: 999px; }
.badge.warning { background: rgba(250,178,25,0.18); color: var(--ink); }
.badge.error { background: rgba(208,59,59,0.16); color: var(--ink); }
.nota { font-size: 12.5px; color: var(--muted); margin-top: 8px; }
footer { max-width: 1180px; margin: 0 auto; padding: 0 24px 32px; color: var(--muted); font-size: 12.5px; }
@media (max-width: 860px) { .g-3, .g-2 { grid-template-columns: 1fr; } .tile .v { font-size: 26px; } }
@media print { nav { display: none; } .card { break-inside: avoid; } }
/*]]>*/
</style>
</head>
<body>
<header>
  <h1>{{ titulo }}</h1>
  <p>Corrida {{ meta.run_id }} · {{ meta.replicas }} réplicas · semilla {{ meta.semilla }} · {{ meta.dias_despacho }} días de despacho 2026 · generado {{ generado }}</p>
</header>
<nav>
  <a href="#resumen">1. Resumen</a><a href="#flota">2. Flota por canal</a><a href="#estacional">3. Capacidad estacional</a>
  <a href="#territorio">4. Territorio</a><a href="#resiliencia">5. Resiliencia</a><a href="#auditoria">6. Auditoría</a>
</nav>
<main>

<section id="resumen">
  <h2>1. Resumen ejecutivo y nivel de servicio</h2>
  <p class="lead">Con la flota configurada, la red despacha a tiempo el {{ tarjetas[0].valor }} de la demanda en el escenario base; las disrupciones lo bajan a {{ tarjetas[1].valor }}. El mes más exigente es {{ mes_peor }} ({{ servicio_peor_mes }} a tiempo).</p>
  <div class="grid g-3">
    {% for t in tarjetas %}
    <div class="card tile"><div class="k">{{ t.etiqueta }}</div><div class="v">{{ t.valor }}</div><div class="n">{{ t.nota }}</div></div>
    {% endfor %}
  </div>
  <div class="grid g-2" style="margin-top:14px">
    <div class="card"><h3>Tasa de devolución por canal (%)</h3><div class="chart"><canvas id="c-devolucion" role="img" aria-label="Tasa de devolución por canal"></canvas></div></div>
    <div class="card"><h3>Servicio a tiempo por canal</h3>
      <div class="scroll"><table>
        <thead><tr><th>Canal / pool</th><th class="num">Base</th><th class="num">Disrupción</th><th class="num">Devolución</th></tr></thead>
        <tbody>{% for p in pools %}<tr><td>{{ p.pool }}</td><td class="num">{{ p.servicio_base }}</td><td class="num">{{ p.servicio_dis }}</td><td class="num">{{ p.devolucion }}</td></tr>{% endfor %}</tbody>
      </table></div>
      <p class="nota">Servicio a tiempo = pallets despachados el mismo día del pedido ÷ demanda. Las devoluciones viajan en el espacio que liberan las entregas.</p>
    </div>
  </div>
</section>

<section id="flota">
  <h2>2. Rendimiento de flota: rutas dedicadas vs capilares</h2>
  <p class="lead">La ruta dedicada se llena por espacio (pallets); las capilares se agotan por paradas antes de llenarse. Por eso cada pool se dimensiona con una restricción distinta.</p>
  <div class="grid g-2">
    <div class="card"><h3>Uso promedio de la capacidad diaria (%)</h3><div class="chart"><canvas id="c-flota" role="img" aria-label="Uso de capacidad por pool"></canvas></div></div>
    <div class="card"><h3>Configuración y saturación</h3>
      <div class="scroll"><table>
        <thead><tr><th>Pool</th><th class="num">Camiones</th><th class="num">Pallets/día</th><th class="num">Paradas/día</th><th class="num">Días saturado</th></tr></thead>
        <tbody>{% for p in pools %}<tr><td>{{ p.pool }}</td><td class="num">{{ p.camiones }}</td><td class="num">{{ p.cap_pallets }}</td><td class="num">{{ p.cap_paradas }}</td><td class="num">{{ p.saturado }}</td></tr>{% endfor %}</tbody>
      </table></div>
      <p class="nota">Capacidad por camión calibrada con el percentil 95 de los camiones-día reales 2023–2025. Días saturado: días del escenario base en que el pool usó el 100 % de su capacidad.</p>
    </div>
  </div>
</section>

<section id="estacional">
  <h2>3. Capacidad estacional: peak vs valle</h2>
  <p class="lead">La demanda diaria varía {{ factor_peak_valle }} veces entre el mes más cargado y el más liviano. La flota fija se satura en los peaks (verano, Fiestas Patrias, diciembre) y queda holgada en el valle invernal.</p>
  <div class="grid g-2">
    <div class="card"><h3>Demanda promedio por día de despacho (pallets)</h3><div class="chart"><canvas id="c-demanda-mes" role="img" aria-label="Demanda mensual"></canvas></div></div>
    <div class="card"><h3>Servicio a tiempo por mes (%)</h3><div class="chart"><canvas id="c-servicio-mes" role="img" aria-label="Servicio mensual"></canvas></div></div>
  </div>
  <div class="card" style="margin-top:14px"><h3>Uso de la restricción que manda en cada pool, por mes (%)</h3><div class="chart"><canvas id="c-uso-mes" role="img" aria-label="Uso de flota por mes"></canvas></div></div>
</section>

<section id="territorio">
  <h2>4. Núcleo conurbado vs periferia</h2>
  <p class="lead">El núcleo concentra el volumen y la mayor parte del canal ancla; la periferia (Vicuña, Andacollo, Tongoy, La Higuera) es casi toda capilar y está a 20–65 km del centro de distribución.</p>
  <div class="grid g-2">
    <div class="card"><h3>Servicio a tiempo por sector (%)</h3><div class="chart tall"><canvas id="c-sectores" role="img" aria-label="Servicio por sector"></canvas></div></div>
    <div class="card"><h3>Resumen por zona</h3>
      <div class="scroll"><table>
        <thead><tr><th>Zona</th><th class="num">Pallets/día</th><th class="num">Servicio base</th><th class="num">Servicio disrupción</th><th class="num">Backlog medio (disr.)</th></tr></thead>
        <tbody>{% for z in zonas %}<tr><td>{{ z.zona }}</td><td class="num">{{ z.demanda }}</td><td class="num">{{ z.servicio_base }}</td><td class="num">{{ z.servicio_dis }}</td><td class="num">{{ z.backlog }}</td></tr>{% endfor %}</tbody>
      </table></div>
      <p class="nota">N1–N8: sectores del núcleo (K-means ponderado por visitas, ≤ 15 km del CD). P1–P5: localidades de la periferia. SIN_GEO: clientes sin coordenadas.</p>
    </div>
  </div>
</section>

<section id="resiliencia">
  <h2>5. Resiliencia y robustez</h2>
  <p class="lead">Ambos escenarios usan exactamente la misma demanda; la diferencia es solo el efecto de las fallas inyectadas. Servicio a tiempo anual: {{ tarjetas[0].valor }} → {{ tarjetas[1].valor }}.</p>
  <div class="card"><h3>Pedidos pendientes al cierre del día (pallets, promedio de réplicas)</h3><div class="chart tall"><canvas id="c-backlog" role="img" aria-label="Backlog diario base vs disrupción"></canvas></div>
    <p class="nota">Las bandas marcan las disrupciones deterministas{% for v in eventos_deterministas %}{% if loop.first %}: {% endif %}{{ v.nombre }} ({{ v.desde }} a {{ v.hasta }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>
  </div>
  <div class="card" style="margin-top:14px"><h3>Recuperación por evento</h3>
    <div class="scroll"><table>
      <thead><tr><th>Evento</th><th>Tipo</th><th class="num">Eventos</th><th class="num">Duración (días)</th><th class="num">Recuperación (días)</th><th class="num">p90</th><th class="num">Pérdida servicio (pp)</th><th class="num">Backlog extra máx.</th><th class="num">Venta perdida extra</th></tr></thead>
      <tbody>{% for r in recuperacion %}<tr><td>{{ r.evento }}</td><td>{{ r.tipo }}</td><td class="num">{{ r.eventos }}</td><td class="num">{{ r.duracion }}</td><td class="num">{{ r.recuperacion }}</td><td class="num">{{ r.recuperacion_p90 }}</td><td class="num">{{ r.perdida }}</td><td class="num">{{ r.backlog_extra }}</td><td class="num">{{ r.perdida_venta }}</td></tr>{% endfor %}</tbody>
    </table></div>
    <p class="nota">Recuperación: días de despacho desde el fin del evento hasta que el backlog vuelve al del escenario base en la misma réplica. Pérdida de servicio: diferencia en puntos porcentuales dentro de la ventana del evento más su recuperación.</p>
  </div>
</section>

<section id="auditoria">
  <h2>6. Auditoría de ejecución</h2>
  <p class="lead">Resumen de los registros de cada escenario (logs .log y .json en la carpeta logs/). Se inyectaron {{ n_eventos }} eventos de disrupción en total entre todas las réplicas.</p>
  <div class="card"><h3>Corridas</h3>
    <div class="scroll"><table>
      <thead><tr><th>Escenario</th><th>Archivo</th><th>Inicio</th><th class="num">Duración (s)</th><th class="num">INFO</th><th class="num">WARNING</th><th class="num">ERROR</th></tr></thead>
      <tbody>{% for e in logs.escenarios %}<tr><td>{{ e.escenario }}</td><td>{{ e.archivo }}</td><td>{{ e.inicio[:19] }}</td><td class="num">{{ e.duracion_s }}</td><td class="num">{{ e.info }}</td><td class="num">{{ e.warning }}</td><td class="num">{{ e.error }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </div>
  <div class="card" style="margin-top:14px"><h3>Registros relevantes (WARNING y ERROR)</h3>
    <div class="scroll"><table>
      <thead><tr><th>Hora</th><th>Escenario</th><th>Nivel</th><th>Mensaje</th></tr></thead>
      <tbody>{% for r in logs.relevantes %}<tr><td>{{ r.hora }}</td><td>{{ r.escenario }}</td><td><span class="badge {{ r.nivel|lower }}">{{ r.nivel }}</span></td><td>{{ r.mensaje }}</td></tr>{% else %}<tr><td colspan="4">Sin advertencias ni errores.</td></tr>{% endfor %}</tbody>
    </table></div>
  </div>
</section>
</main>
<footer>Generado automáticamente por andesbev-sim. Gráficos: Chart.js 4.4.1 (licencia MIT), incrustado.</footer>

<script>
//<![CDATA[
{{ chartjs|safe }}
//]]>
</script>
<script>
//<![CDATA[
(function () {
  const D = {{ datos_json|safe }};
  const MESES = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
  const css = getComputedStyle(document.documentElement);
  const v = (n) => css.getPropertyValue(n).trim();
  const C = { s1: v('--s1'), s2: v('--s2'), s3: v('--s3'), ink: v('--ink'), ink2: v('--ink-2'),
              muted: v('--muted'), grid: v('--grid'), axis: v('--axis'), band: v('--band') };
  Chart.defaults.font.family = 'system-ui, -apple-system, "Segoe UI", sans-serif';
  Chart.defaults.font.size = 12;
  Chart.defaults.color = C.muted;
  Chart.defaults.maintainAspectRatio = false;
  Chart.defaults.plugins.legend.labels.color = C.ink2;
  Chart.defaults.plugins.legend.labels.boxWidth = 10;
  Chart.defaults.plugins.legend.labels.boxHeight = 10;
  Chart.defaults.plugins.tooltip.mode = 'index';
  Chart.defaults.plugins.tooltip.intersect = false;
  const ejes = (yTitulo, extra) => Object.assign({
    x: { grid: { display: false }, border: { color: C.axis }, ticks: { color: C.muted } },
    y: { grid: { color: C.grid }, border: { display: false }, ticks: { color: C.muted },
         title: { display: !!yTitulo, text: yTitulo, color: C.muted } }
  }, extra || {});
  const barra = (color) => ({ backgroundColor: color, borderRadius: 4, borderSkipped: 'start',
                              maxBarThickness: 28, categoryPercentage: 0.7, barPercentage: 0.9 });
  const linea = (color) => ({ borderColor: color, backgroundColor: color, borderWidth: 2,
                              pointRadius: 0, pointHoverRadius: 4, tension: 0 });

  new Chart(document.getElementById('c-devolucion'), {
    type: 'bar',
    data: { labels: D.devolucion.pools, datasets: [Object.assign({ label: 'Devolución (%)', data: D.devolucion.tasa }, barra(C.s1))] },
    options: { indexAxis: 'y', plugins: { legend: { display: false } },
               scales: ejes(null, { x: { beginAtZero: true, grid: { color: C.grid }, border: { display: false }, ticks: { callback: (x) => x + ' %' } },
                                    y: { grid: { display: false }, border: { color: C.axis } } }) }
  });

  new Chart(document.getElementById('c-flota'), {
    type: 'bar',
    data: { labels: D.flota.pools, datasets: [
      Object.assign({ label: 'Espacio (pallets)', data: D.flota.uso_pallets }, barra(C.s1)),
      Object.assign({ label: 'Paradas', data: D.flota.uso_paradas }, barra(C.s2)) ] },
    options: { plugins: { legend: { position: 'top', align: 'start' } },
               scales: ejes('% de la capacidad', { y: { min: 0, max: 100, grid: { color: C.grid }, border: { display: false } } }) }
  });

  new Chart(document.getElementById('c-demanda-mes'), {
    type: 'line',
    data: { labels: D.mensual.meses, datasets: [Object.assign({ label: 'Pallets por día', data: D.mensual.demanda, pointRadius: 3 }, linea(C.s1))] },
    options: { plugins: { legend: { display: false } }, scales: ejes('pallets/día') }
  });

  new Chart(document.getElementById('c-servicio-mes'), {
    type: 'line',
    data: { labels: D.mensual.meses, datasets: [
      Object.assign({ label: 'Base', data: D.mensual.servicio_base, pointRadius: 3 }, linea(C.s1)),
      Object.assign({ label: 'Disrupción', data: D.mensual.servicio_dis, pointRadius: 3 }, linea(C.s2)) ] },
    options: { plugins: { legend: { position: 'top', align: 'start' } }, scales: ejes('%') }
  });

  const colores = [C.s1, C.s2, C.s3];
  new Chart(document.getElementById('c-uso-mes'), {
    type: 'line',
    data: { labels: D.mensual.meses, datasets: Object.keys(D.mensual.uso).map((k, i) =>
      Object.assign({ label: k, data: D.mensual.uso[k], pointRadius: 3 }, linea(colores[i]))) },
    options: { plugins: { legend: { position: 'top', align: 'start' } },
               scales: ejes('% de la capacidad', { y: { min: 40, max: 100, grid: { color: C.grid }, border: { display: false } } }) }
  });

  new Chart(document.getElementById('c-sectores'), {
    type: 'bar',
    data: { labels: D.sectores.sectores, datasets: [
      Object.assign({ label: 'Base', data: D.sectores.base }, barra(C.s1)),
      Object.assign({ label: 'Disrupción', data: D.sectores.dis }, barra(C.s2)) ] },
    options: { indexAxis: 'y', plugins: { legend: { position: 'top', align: 'start' } },
               scales: { x: { min: 70, max: 100, grid: { color: C.grid }, border: { display: false }, ticks: { callback: (x) => x + ' %' } },
                         y: { grid: { display: false }, border: { color: C.axis } } } }
  });

  // Bandas sombreadas para las ventanas de disrupción (plugin propio, sin dependencias)
  const bandas = {
    id: 'bandas',
    beforeDatasetsDraw(chart) {
      const { ctx, chartArea: a, scales: { x } } = chart;
      const etiquetas = chart.data.labels;
      ctx.save();
      ctx.fillStyle = C.band;
      D.diario.ventanas.forEach((w) => {
        const i0 = etiquetas.findIndex((f) => f >= w.desde);
        let i1 = etiquetas.findIndex((f) => f > w.hasta);
        if (i0 < 0) return;
        if (i1 < 0) i1 = etiquetas.length - 1;
        const x0 = x.getPixelForValue(i0) - 2, x1 = x.getPixelForValue(i1);
        ctx.fillRect(x0, a.top, Math.max(4, x1 - x0), a.bottom - a.top);
      });
      ctx.restore();
    }
  };
  new Chart(document.getElementById('c-backlog'), {
    type: 'line',
    data: { labels: D.diario.fechas, datasets: [
      Object.assign({ label: 'Base', data: D.diario.backlog_base, borderWidth: 1.5 }, linea(C.s1), { borderWidth: 1.5 }),
      Object.assign({ label: 'Disrupción', data: D.diario.backlog_dis }, linea(C.s2), { borderWidth: 1.5 }) ] },
    options: { plugins: { legend: { position: 'top', align: 'start' } },
               scales: ejes('pallets', { x: { grid: { display: false }, border: { color: C.axis },
                 ticks: { autoSkip: false, maxRotation: 0, color: C.muted, callback: (val) => {
                   const f = D.diario.fechas, l = f[val], prev = f[val - 1];
                   return (!prev || prev.slice(5, 7) !== l.slice(5, 7)) ? MESES[Number(l.slice(5, 7)) - 1] : '';
                 } } } }) },
    plugins: [bandas]
  });
})();
//]]>
</script>
</body>
</html>
